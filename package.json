{
  "name": "groma",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "scripts": {
    "validate:architecture": "node scripts/validate-architecture.mjs",
    "source:refresh": "node src/source-refresh-process.mjs",
    "viewer": "bun run src/viewer/server.mjs",
    "test:release-gate": "playwright test --config playwright.release-gate.config.mjs",
    "test:viewer:browser": "playwright test",
    "test": "node --test",
    "check": "bun run validate:architecture && bun run test"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "comark": "0.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0"
  }
}
