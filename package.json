{
  "name": "groma.md",
  "version": "0.4.0",
  "description": "Your architecture as Markdown in Git, and one C4 map you can walk. Scanned from source, curated by people and agents.",
  "license": "MIT",
  "author": "Alex Gavrilescu",
  "homepage": "https://groma.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLesk/Groma.md.git"
  },
  "bugs": {
    "url": "https://github.com/MrLesk/Groma.md/issues"
  },
  "keywords": [
    "architecture",
    "c4",
    "c4-model",
    "markdown",
    "documentation",
    "diagram",
    "git",
    "cli",
    "tui",
    "isometric",
    "okf",
    "coding-agents",
    "backlog"
  ],
  "private": false,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/scanners/*",
    "plugins/work-sources/*"
  ],
  "bin": {
    "groma": "src/cli.ts"
  },
  "packageManager": "bun@1.4.1",
  "engines": {
    "bun": ">=1.4.1",
    "node": ">=20.19.0"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --version && tsc --noEmit",
    "test": "bun run test:node && bun run test:viewer",
    "test:csharp": "dotnet test plugins/scanners/csharp/dotnet/test/Groma.CSharpScanner.Tests.csproj",
    "test:node": "node --import=tsx --test test/*.test.ts",
    "test:viewer": "bun test --parallel=2 --max-concurrency 1 --timeout 20000 test-bun/",
    "check": "biome lint && bun scripts/lint-web-scrollbars.ts && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "@comark/html": "0.7.0",
    "@groma/scanner": "workspace:*",
    "@groma/work-source": "workspace:*",
    "@groma/work-source-backlog": "workspace:*",
    "@opentui/core": "0.5.12",
    "@parcel/watcher": "2.6.0",
    "@resvg/resvg-wasm": "2.6.2",
    "comark": "0.7.0",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "fuse.js": "7.5.0",
    "ignore": "7.0.10"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.1.0-dev.20260924.1"
  },
  "patchedDependencies": {
    "@parcel/watcher@2.6.0": "patches/@parcel%2Fwatcher@2.6.0.patch"
  }
}
