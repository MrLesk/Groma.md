{
  "name": "groma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugins/scanners/*"
  ],
  "bin": {
    "groma": "src/cli.ts"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "typecheck": "tsc --version && tsc --noEmit",
    "test": "bun run test:node && bun run test:viewer",
    "test:csharp": "dotnet test plugins/scanners/csharp/dotnet/test/Groma.CSharpScanner.Tests.csproj",
    "test:node": "node --import=tsx --test test/*.test.ts",
    "test:viewer": "bun test --timeout 20000 test-bun/",
    "check": "biome lint && bun scripts/lint-web-scrollbars.ts && bun run typecheck && bun run test"
  },
  "dependencies": {
    "@groma/scanner": "workspace:*",
    "@groma/scanner-csharp": "workspace:*",
    "@groma/scanner-typescript": "workspace:*",
    "@comark/html": "0.5.1",
    "@opentui/core": "0.5.1",
    "comark": "0.5.1",
    "commander": "15.0.0",
    "diff": "9.0.0",
    "elkjs": "0.12.0",
    "fuse.js": "7.5.0",
    "libavoid-js": "0.5.0-beta.5",
    "typescript": "7.1.0-dev.20260830.1",
    "web-worker": "1.5.0",
    "webcola": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/bun": "^1.3.14",
    "@types/node": "20",
    "tsx": "^4.23.12"
  }
}
