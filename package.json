{
  "name": "groma",
  "private": true,
  "type": "module",
  "bin": {
    "groma": "src/cli.ts"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=20.19.0"
  },
  "scripts": {
    "cli": "bun src/cli.ts",
    "validate:architecture": "node --import=tsx scripts/validate-architecture.ts",
    "typecheck": "tsc --version && tsc --noEmit",
    "test": "bun run test:node && bun run test:viewer",
    "test:node": "node --import=tsx --test test/*.test.ts",
    "test:viewer": "bun test --timeout 20000 test-bun/",
    "check": "bun run typecheck && bun run validate:architecture && bun run test"
  },
  "dependencies": {
    "@opentui/core": "0.5.1",
    "comark": "0.5.1",
    "elkjs": "0.12.0",
    "three": "0.185.1",
    "web-worker": "1.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "20",
    "@types/three": "0.185.4",
    "tsx": "^4.23.12",
    "typescript": "7.0.2"
  }
}
