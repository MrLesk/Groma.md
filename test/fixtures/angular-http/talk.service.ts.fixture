import { Inject, Injectable, inject } from '@angular/core'
import { HttpClient, HttpRequest, httpResource } from '@angular/common/http'
import { API_ROOT, API_TOKEN } from 'app-config'
import { environment } from './environment'

const routes = { talks: '/api/talks' }
const moved = { url: '/api/talks' }
moved.url = '/api/elsewhere'

@Injectable({ providedIn: 'root' })
export class TalkService {
  private readonly base = '/api'

  constructor(private http: HttpClient) {}

  list() {
    return this.http.get('/api/talks')
  }

  create(talk: unknown) {
    return this.http.post('/api/talks', talk)
  }

  replace(id: string, talk: unknown) {
    return this.http.put(`/api/talks/${id}`, talk)
  }

  amend(id: string, patch: unknown) {
    return this.http.patch(`/api/talks/${id}`, patch)
  }

  remove(id: string) {
    return this.http.delete(`/api/talks/${id}`)
  }

  exists() {
    return this.http.head('/api/talks')
  }

  allowed() {
    return this.http.options('/api/talks')
  }

  purge(id: string) {
    return this.http.request('DELETE', `/api/talks/${id}`)
  }

  byMethod(method: string) {
    return this.http.request(method, '/api/talks')
  }

  packaged() {
    return this.http.request(new HttpRequest('GET', '/api/talks'))
  }

  latest() {
    return this.http.get(this.base + '/talks/latest')
  }

  search(term: string) {
    return this.http.get('/api/talks?term=' + term)
  }

  external() {
    return this.http.get(`${environment.apiUrl}/talks`)
  }

  configured() {
    return this.http.get(`${API_ROOT}/talks`)
  }

  partial(id: string) {
    return this.http.get(`/api/talks/${id}-latest`)
  }

  routed() {
    return this.http.get(routes.talks)
  }

  changed() {
    return this.http.get(moved.url)
  }

  fromBase(base: string) {
    return this.http.get(base + '/talks')
  }

  viaHelper() {
    return this.send('/api/talks')
  }

  private send(path: string) {
    return this.http.get(path)
  }
}

@Injectable({ providedIn: 'root' })
export class SpeakerService {
  private readonly http = inject(HttpClient)

  one(id: string) {
    return this.http.get(`/api/speakers/${id}`)
  }
}

@Injectable({ providedIn: 'root' })
export class DraftStore {
  get(key: string): string {
    return key
  }
}

@Injectable({ providedIn: 'root' })
export class DraftService {
  constructor(private drafts: DraftStore) {}

  read() {
    return this.drafts.get('/api/talks')
  }
}

@Injectable({ providedIn: 'root' })
export class SpeakerAccountService {
  // A field holds its one assignment; one the sources never assign, such as an injected one, is the
  // client's own setting, and one assigned twice is unknown.
  private resourceUrl = API_ROOT + '/api/speakers'
  private moving = '/api/first'

  constructor(private http: HttpClient, @Inject(API_TOKEN) private baseUrl: string) {}

  users() {
    return this.http.get(this.resourceUrl + '/users')
  }

  injected() {
    return this.http.get(this.baseUrl + '/talks')
  }

  relocate() {
    this.moving = '/api/second'
  }

  moved() {
    return this.http.get(this.moving + '/talks')
  }
}

@Injectable({ providedIn: 'root' })
export class TalkFeedService {
  private readonly http = inject(HttpClient)
  // A field initializer runs while the class is constructed.
  readonly feed = this.http.get('/api/feed')
  // The function passed to httpResource supplies the URL; a request object states its method.
  readonly talk = httpResource(() => `/api/talks/${this.selected()}`)
  readonly saved = httpResource(() => ({ url: '/api/saved', method: 'POST' }))

  constructor() {
    this.http.get('/api/boot')
  }

  selected() {
    return 'first'
  }
}
