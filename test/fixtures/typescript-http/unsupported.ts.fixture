import express, { Router } from 'express'

const orphan = Router()
const patterns = express()
const hidden = Router()

orphan.get('/orphan', handle)
patterns.get(routeFor('talks'), handle)
patterns.get('/files/:id(\\d+)', handle)
patterns.get('setting')
patterns.use(prefixFor(), hidden)
hidden.get('/hidden', handle)
// A computed segment blocks from the last whole segment before it, a remainder pattern is a catch-all,
// and a pattern that may span segments blocks from its place.
patterns.get(`/versions/v-${routeFor('latest')}`, handle)
patterns.get('/assets/:rest(.*)', handle)
patterns.get('/archives/:name(.*\\.zip)', handle)
// Express 5's optional wildcard may match nothing more, and a group before more path blocks from its place.
patterns.get('/files{/*path}', handle)
patterns.get('/users{/:id}/posts', handle)

function routeFor(name: string): string {
  return `/${name}`
}

function prefixFor(): string {
  return '/x'
}

function handle(): string {
  return 'handled'
}

export async function jobRoutes(fastify: { get(path: string, handler: () => string): void }): Promise<void> {
  fastify.get('/plugin-route', handle)
  await Promise.resolve()
}

const hosted = Router()

hosted.get('/hosted', handle)
createApp().use('/api', hosted)

function createApp(): ReturnType<typeof express> {
  return express()
}
