import { serve } from '@hono/node-server'
import { Hono } from 'hono'
import { guard, items } from './hono-routes'

const rooms = new Hono()
const site = new Hono()

rooms.get('/rooms/:room?', listRooms)
site.route('/v1', rooms)
site.route('/v2', rooms)
site.all('/legacy/*', forward)
site.on('PURGE', '/cache/*', forward)
site.basePath('/api').get('/hidden', forward)
serve(site)
site.use(guard)

// `route` copies the routes the child has when it runs, so a later route is not under it.
const late = new Hono()
site.route('/late', late)
late.get('/talks', forward)

// A child from another module has its top-level routes before this file runs.
site.route('/shop', items)

function listRooms(): string {
  return 'rooms'
}

function forward(): string {
  return 'forwarded'
}

export default site
