{
  "scanners": [
    {
      "id": "angular",
      "source": "./plugins/scanners/angular",
      "include": [
        "**/*.ts",
        "**/*.html",
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.styl",
        "**/tsconfig*.json",
        "**/package.json",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.spec.ts",
        "*.test.ts",
        ".angular/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "csharp",
      "source": "./plugins/scanners/csharp",
      "settings": {
        "input": "plugins/scanners/csharp/dotnet/Groma.CSharpScanner.csproj"
      },
      "include": [
        "**/*.[cC][sS]",
        "**/*.[cC][sS][pP][rR][oO][jJ]",
        "**/*.[sS][lL][nN]",
        "**/*.[sS][lL][nN][xX]",
        "**/*.[pP][rR][oO][pP][sS]",
        "**/*.[tT][aA][rR][gG][eE][tT][sS]"
      ],
      "exclude": [
        "[bB][iI][nN]/",
        "[oO][bB][jJ]/",
        "[tT]est/",
        "[tT]ests/",
        "*Tests/",
        "*.Test/",
        "*.[dD]esigner.cs",
        "*.g.cs",
        "*.g.i.cs",
        "*.generated.cs"
      ]
    },
    {
      "id": "go",
      "source": "./plugins/scanners/go",
      "include": [
        "**/*.go",
        "**/go.mod"
      ],
      "exclude": [
        "vendor/"
      ]
    },
    {
      "id": "java",
      "source": "./plugins/scanners/java",
      "include": [
        "**/*.java",
        "**/pom.xml",
        "**/build.gradle",
        "**/build.gradle.kts",
        "**/settings.gradle",
        "**/settings.gradle.kts"
      ],
      "exclude": [
        "target/",
        "build/",
        ".gradle/",
        "/plugins/scanners/java/java/"
      ]
    },
    {
      "id": "react",
      "source": "./plugins/scanners/react",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "rust",
      "source": "./plugins/scanners/rust",
      "settings": {
        "manifest": "plugins/scanners/rust/native/Cargo.toml"
      },
      "include": [
        "**/*.rs",
        "**/Cargo.toml"
      ],
      "exclude": [
        "target/",
        "vendor/"
      ]
    },
    {
      "id": "typescript",
      "source": "./plugins/scanners/typescript",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "vue",
      "source": "./plugins/scanners/vue",
      "include": [
        "**/*.vue",
        "**/*.ts",
        "**/*.tsx",
        "**/*.mts",
        "**/*.cts",
        "**/*.js",
        "**/*.jsx",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.html",
        "**/*.css",
        "**/*.scss",
        "**/*.sass",
        "**/*.less",
        "**/*.styl",
        "**/tsconfig*.json",
        "**/package.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    }
  ],
  "exclude": [
    "/scripts/",
    "/test/",
    "/test-bun/",
    "/plugins/scanners/csharp/dotnet/test/",
    "/examples/",
    "/plugins/scanners/*/build.ts",
    "/plugins/scanners/framework-package.ts",
    "/plugins/scanners/rust/notices.ts"
  ]
}
