{
  "scanners": [
    {
      "id": "angular",
      "source": "./plugins/scanners/angular",
      "exclude": [
        "*.spec.ts",
        "*.test.ts",
        ".angular/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "csharp",
      "source": "./plugins/scanners/csharp",
      "settings": {
        "input": "plugins/scanners/csharp/dotnet/Groma.CSharpScanner.csproj"
      },
      "exclude": [
        "[bB][iI][nN]/",
        "[oO][bB][jJ]/",
        "[tT]est/",
        "[tT]ests/",
        "*Tests/",
        "*.Test/",
        "*.[dD]esigner.cs",
        "*.g.cs",
        "*.g.i.cs",
        "*.generated.cs"
      ]
    },
    {
      "id": "go",
      "source": "./plugins/scanners/go",
      "exclude": [
        "vendor/"
      ]
    },
    {
      "id": "java",
      "source": "./plugins/scanners/java",
      "exclude": [
        "target/",
        "build/",
        ".gradle/"
      ]
    },
    {
      "id": "react",
      "source": "./plugins/scanners/react",
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "rust",
      "source": "./plugins/scanners/rust",
      "settings": {
        "manifest": "plugins/scanners/rust/native/Cargo.toml"
      },
      "exclude": [
        "target/",
        "vendor/"
      ]
    },
    {
      "id": "typescript",
      "source": "./plugins/scanners/typescript",
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "vue",
      "source": "./plugins/scanners/vue",
      "exclude": [
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    }
  ],
  "exclude": [
    "/scripts/",
    "/test/",
    "/test-bun/",
    "/plugins/scanners/csharp/dotnet/test/",
    "/examples/",
    "/plugins/scanners/*/build.ts",
    "/plugins/scanners/framework-package.ts",
    "/plugins/scanners/rust/notices.ts"
  ]
}
