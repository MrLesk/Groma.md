{
  "name": "@groma/scanner-rust",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "groma": {
    "scanner": {
      "id": "rust",
      "entry": "./src/index.ts",
      "include": [
        "**/*.rs",
        "**/Cargo.toml"
      ],
      "exclude": [
        "target/",
        "vendor/"
      ],
      "discovery": {
        "technologies": [
          "rust"
        ],
        "rules": [
          {
            "type": "toml",
            "files": [
              "**/Cargo.toml"
            ],
            "technology": "rust",
            "kind": "language",
            "tables": [
              "package",
              "workspace"
            ],
            "versionPath": [
              "package",
              "rust-version"
            ],
            "declaration": "Cargo package or workspace"
          }
        ],
        "compatibility": {
          "groma": ">=0.5.0"
        }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*"
  },
  "description": "Rust project evidence through established semantic tooling."
}
