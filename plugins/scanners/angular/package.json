{
  "name": "@groma/scanner-angular",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "groma": {
    "scanner": {
      "id": "angular",
      "entry": "./dist/package/dist/index.js",
      "discovery": {
        "technologies": [
          "angular"
        ],
        "rules": [
          {
            "type": "dependency",
            "files": [
              "**/package.json"
            ],
            "technology": "angular",
            "kind": "framework",
            "package": "@angular/core"
          }
        ],
        "compatibility": {
          "groma": "^0.3.0"
        }
      }
    }
  },
  "dependencies": {
    "@angular/compiler": "21.2.17",
    "@angular/compiler-cli": "21.2.17",
    "@groma/scanner": "workspace:*",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@angular/core": "21.2.17"
  },
  "description": "Complementary Angular framework evidence with its own compatible TypeScript tooling."
}
