{
  "name": "@groma/scanner-csharp",
  "version": "0.1.4",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "groma": {
    "scanner": {
      "id": "csharp",
      "entry": "./src/index.ts",
      "exclude": [
        "[bB][iI][nN]/",
        "[oO][bB][jJ]/",
        "[tT]est/",
        "[tT]ests/",
        "*Tests/",
        "*.Test/",
        "*.[dD]esigner.cs",
        "*.g.cs",
        "*.g.i.cs",
        "*.generated.cs"
      ],
      "discovery": {
        "technologies": [
          "csharp"
        ],
        "rules": [
          {
            "type": "xml",
            "files": [
              "**/*.csproj"
            ],
            "technology": "csharp",
            "kind": "language",
            "versionTags": [
              "TargetFramework",
              "TargetFrameworks"
            ],
            "declaration": "MSBuild TargetFramework"
          }
        ],
        "compatibility": {
          "groma": ">=0.3.0"
        }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*"
  },
  "description": "C# project evidence through Roslyn.",
  "private": false
}
