{
  "name": "@groma/scanner-csharp",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "groma": {
    "scanner": {
      "id": "csharp",
      "entry": "./src/index.ts",
      "discovery": {
        "technologies": [
          "csharp"
        ],
        "rules": [
          {
            "type": "xml",
            "files": [
              "**/*.csproj"
            ],
            "technology": "csharp",
            "kind": "language",
            "versionTags": [
              "TargetFramework",
              "TargetFrameworks"
            ],
            "declaration": "MSBuild TargetFramework"
          }
        ],
        "compatibility": {
          "groma": "^0.3.0",
          "technologyVersions": {}
        }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*"
  },
  "description": "C# project evidence through Roslyn and MSBuild.",
  "private": false
}
