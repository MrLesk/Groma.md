{
  "name": "@groma/scanner-php",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "PHP source declarations and operations without project dependencies.",
  "groma": {
    "scanner": {
      "id": "php",
      "entry": "./src/index.ts",
      "include": [
        "**/*.php",
        "**/composer.json",
        "**/bin/*",
        "**/artisan"
      ],
      "exclude": [
        "vendor/"
      ],
      "discovery": {
        "technologies": [
          "php"
        ],
        "rules": [
          {
            "type": "file",
            "files": [
              "**/*.php"
            ],
            "technology": "php",
            "kind": "language",
            "declaration": "PHP source files"
          }
        ],
        "compatibility": {
          "groma": ">=0.5.0"
        }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*",
    "php-parser": "3.7.0"
  }
}
