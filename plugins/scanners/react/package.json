{
  "name": "@groma/scanner-react",
  "version": "0.1.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "groma": {
    "scanner": {
      "id": "react",
      "entry": "./dist/package/dist/index.js",
      "discovery": {
        "technologies": [
          "react"
        ],
        "rules": [
          {
            "type": "dependency",
            "files": [
              "**/package.json"
            ],
            "technology": "react",
            "kind": "framework",
            "package": "react"
          }
        ],
        "compatibility": {
          "groma": "^0.3.0",
          "technologyVersions": {
            "react": "19.2.7 || 19.2.8"
          }
        }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "react": "19.2.7"
  },
  "description": "Complementary React framework evidence; a dependency declaration does not verify runtime use."
}
