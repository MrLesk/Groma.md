{
  "name": "@groma/scanner-react",
  "version": "0.1.5",
  "private": false,
  "type": "module",
  "license": "MIT",
  "groma": {
    "scanner": {
      "id": "react",
      "entry": "./dist/package/dist/index.js",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ],
      "discovery": {
        "technologies": [
          "react"
        ],
        "rules": [
          {
            "type": "dependency",
            "files": [
              "**/package.json"
            ],
            "technology": "react",
            "kind": "framework",
            "package": "react"
          }
        ],
        "compatibility": {
          "groma": ">=0.3.0"
        }
      }
    }
  },
  "dependencies": {
    "@groma/scanner": "workspace:*",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0"
  },
  "description": "Complementary React framework evidence; a dependency declaration does not verify runtime use."
}
